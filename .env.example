# Copy to .env — never commit real .env

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Public site URL (no trailing slash) — used for canonical, Open Graph, and JSON-LD in index.html
# VITE_SITE_URL=https://www.your-domain.com

# Password reset emails are sent BY SUPABASE (not this repo). Configure Gmail SMTP in:
# Supabase Dashboard → Project Settings → Authentication → SMTP
# Use Gmail "App password" (16 chars), not OAuth client secret.
# Redirect URLs must include: http://localhost:5173/reset-password and your production /reset-password

# --- VAULT (Edge Functions / CLI only — never VITE_*) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_VERIFICATION_CONTENT_SID=HXyour_content_sid
# WHATSAPP_OTP_PEPPER=   # openssl rand -hex 32
# SUPABASE_SERVICE_ROLE_KEY=   # local testing only; hosted functions use Dashboard secrets
#
# SMTP (Edge Functions email-reset-*; set same keys in Dashboard → Edge Functions → Secrets)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME=StayOnStay
# EMAIL_RESET_OTP_DIGITS=6
# EMAIL_RESET_OTP_PEPPER=   # optional; falls back to WHATSAPP_OTP_PEPPER
